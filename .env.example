# Local development only. Change credentials before deployment.
# Put real values in the protected actual .env, never this tracked example.
# See docs/DEPLOYMENT.md for the complete variable inventory and release gates.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
POSTGRES_USER=dukanos
POSTGRES_PASSWORD=dukanos_local_only
POSTGRES_DB=dukanos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dukanos:dukanos_local_only@127.0.0.1:5433/dukanos

# Persistent data defaults to ~/.local/share/dukanos.
# Back up uploads/menu AND uploads/expenses together with PostgreSQL.
# Set an absolute directory outside the source checkout in production:
# DUKANOS_DATA_DIR=/var/lib/dukanos

# Counter order business date resets at midnight in this timezone.
RESTAURANT_TIMEZONE=Asia/Kolkata
# Generic exclusive order tax; set according to applicable restaurant billing rules.
ORDER_TAX_RATE=0
ORDER_TAX_LABEL=Tax

# KDS attention only; total order age >= this many minutes is late.
KITCHEN_LATE_THRESHOLD_MINUTES=15

# Minutes since READY before Dispatch uses static late highlighting (1–1440).
DISPATCH_LATE_THRESHOLD_MINUTES=5

# Reports generate locally even with no SMTP. Recipient settings default OFF.
DAILY_REPORT_DELAY_MINUTES=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DukanOS
# Remote SMTP requires validated TLS (implicit TLS or STARTTLS).
# Plain SMTP is allowed only for loopback test/relay hosts.
