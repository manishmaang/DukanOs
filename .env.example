# Local development only. Change credentials before deployment.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
POSTGRES_USER=dukanos
POSTGRES_PASSWORD=dukanos_local_only
POSTGRES_DB=dukanos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dukanos:dukanos_local_only@127.0.0.1:5433/dukanos

# Persistent media defaults to ~/.local/share/dukanos/uploads/menu.
# Set an absolute directory outside the source checkout in production:
# DUKANOS_DATA_DIR=/var/lib/dukanos

# Counter order business date resets at midnight in this timezone.
RESTAURANT_TIMEZONE=Asia/Kolkata
# Generic exclusive order tax; set according to applicable restaurant billing rules.
ORDER_TAX_RATE=0
ORDER_TAX_LABEL=Tax

# KDS attention only; total order age >= this many minutes is late.
KITCHEN_LATE_THRESHOLD_MINUTES=15
