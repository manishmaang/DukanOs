{
  "name": "dukanos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @dukanos/api\" \"npm run dev -w @dukanos/web\"",
    "build": "npm run build -w @dukanos/api && npm run build -w @dukanos/web",
    "start": "npm run start -w @dukanos/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @dukanos/api && node --experimental-strip-types --test apps/web/test/*.test.cjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check",
    "auth:bootstrap": "npm run build -w @dukanos/api && node --env-file=.env scripts/bootstrap-owner.cjs",
    "test:integration": "npm run build -w @dukanos/api && node --env-file=.env --test apps/api/test/integration/*.test.cjs",
    "auth:reset-owner": "npm run build -w @dukanos/api && node --env-file=.env scripts/reset-owner.cjs",
    "media:cleanup": "npm run build -w @dukanos/api && node --env-file=.env scripts/cleanup-menu-media.cjs",
    "test:menu-browser": "npm run build && node --env-file=.env scripts/test-menu-browser.cjs",
    "test:responsive-browser": "npm run build && node --env-file=.env scripts/test-responsive-browser.cjs",
    "test:dispatch-browser": "npm run build && node --env-file=.env scripts/test-dispatch-browser.cjs",
    "test:kitchen-browser": "npm run build && node --env-file=.env scripts/test-kitchen-browser.cjs",
    "test:bills-browser": "npm run build && node --env-file=.env scripts/test-bills-browser.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
