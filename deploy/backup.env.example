# Protected root-readable /etc/dukanos/backup.env. No real values in Git.
DATABASE_URL=postgresql://MIGRATION_ROLE:PASSWORD@PRIVATE_DATABASE_HOST/DATABASE?sslmode=verify-full&sslrootcert=/etc/dukanos/rds-ca.pem
DUKANOS_DB_SCHEMA=dukanos
DUKANOS_DATA_DIR=/var/lib/dukanos
BACKUP_CONFIG_DIR=/etc/dukanos
BACKUP_DIR=/var/backups/dukanos
BACKUP_GPG_RECIPIENT=REPLACE_WITH_VERIFIED_PUBLIC_KEY_FINGERPRINT
GNUPGHOME=/etc/dukanos/backup-public-keyring
BACKUP_RETENTION_DAYS=14
# Choose exactly one configured off-instance destination.
BACKUP_S3_URI=
BACKUP_OFFSITE_DIR=
